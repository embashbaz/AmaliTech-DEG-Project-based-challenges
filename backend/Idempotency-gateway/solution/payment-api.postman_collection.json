{
  "info": {
    "name": "Payment Gateway API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Process Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "X-Client-Id",
            "value": "postman-tester"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 300,\n  \"currency\": \"Rwf\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/process-payment",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["process-payment"]
        }
      }
    }
  ]
}